# ── Streamlit Cloud Secrets Template ──
# Copy to .streamlit/secrets.toml after deploying, or set as secrets in Streamlit Cloud UI

# Choose ONE LLM provider:

# NVIDIA (free API key at https://build.nvidia.com)
OPENAI_API_KEY = "nvapi-..."
# NVIDIA_MODEL = "meta/llama-3.1-70b-instruct"

# OpenAI
# OPENAI_API_KEY = "sk-..."
# LLM_PROVIDER = "openai"
# OPENAI_MODEL = "gpt-4o-mini"

# Anthropic
# ANTHROPIC_API_KEY = "sk-ant-..."
# LLM_PROVIDER = "anthropic"
# ANTHROPIC_MODEL = "claude-3-5-haiku-latest"

# Optional: connect to PostgreSQL or MySQL instead of SQLite
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"
# DATABASE_URL = "mysql://user:password@host:3306/dbname"
